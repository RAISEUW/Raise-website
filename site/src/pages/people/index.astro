---
import Base from '../../layouts/Base.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getCollection } from 'astro:content';

const allPeople = await getCollection('people');
const sorted = allPeople.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const roles = [
  { key: 'leadership', label: 'Leadership' },
  { key: 'affiliate', label: 'Affiliates' },
  { key: 'staff', label: 'Staff' },
  { key: 'alumni', label: 'Alumni' },
];
---

<Base
  title="People — RAISE"
  description="The researchers, faculty, and staff behind RAISE at the University of Washington."
>
  <section class="page-hero">
    <div class="container">
      <span class="section-label animate-fade-up">The Team</span>
      <h1 class="animate-fade-up animate-delay-100">People</h1>
      <p class="page-desc animate-fade-up animate-delay-200">{sorted.length} researchers, faculty, and staff advancing responsible AI.</p>
    </div>
  </section>

  <div class="container">
    {roles.map((role) => {
      const group = sorted.filter((p) => p.data.role === role.key);
      if (group.length === 0) return null;
      return (
        <section class="people-section">
          <h2 class="people-section-title">{role.label}</h2>
          <div class="people-grid">
            {group.map((person) => (
              <div class="reveal">
                <PersonCard slug={person.id} {...person.data} />
              </div>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</Base>

<style>
.page-hero { padding: 4rem 0 2rem; border-bottom: 1px solid var(--color-border); }
.page-hero h1 { font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 300; margin: 0.5rem 0 1rem; }
.page-desc { color: var(--color-muted); max-width: 56ch; }

.container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

.section-label {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-accent);
  display: block;
  margin-bottom: 0.5rem;
}

.people-section { padding: 3rem 0; border-top: 1px solid var(--color-border); }
.people-section:first-child { border-top: none; }

.people-section-title {
  font-size: 1.1rem;
  font-weight: 600;
  font-family: var(--font-mono);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: 1.5rem;
}

.people-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 1rem;
}

@media (max-width: 640px) {
  .people-grid { grid-template-columns: 1fr; }
}
</style>
