---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntries, render } from 'astro:content';
import LinkedContentList from '../../components/LinkedContentList.astro';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((p) => ({ params: { slug: p.id }, props: p }));
}

const person = Astro.props;
const { Content } = await render(person);

const linkedPubs = person.data.linkedPublications.length
  ? await getEntries(person.data.linkedPublications)
  : [];
const linkedTalks = person.data.linkedTalks.length
  ? await getEntries(person.data.linkedTalks)
  : [];
---

<Base
  title={`${person.data.name} — RAISE People`}
  description={`${person.data.title}${person.data.department ? `, ${person.data.department}` : ''} at the University of Washington.`}
>
  <article class="person-detail" data-pagefind-body>
    <div class="container">
      <nav class="breadcrumb">
        <a href="/people">← People</a>
      </nav>

      <div class="person-header">
        <div class="person-photo">
          {person.data.photo
            ? <img src={person.data.photo} alt={person.data.name} width="200" height="200" />
            : <div class="person-initials">{person.data.name.split(' ').map((n: string) => n[0]).join('')}</div>
          }
        </div>
        <div class="person-intro">
          <span class="person-role-label">{person.data.role}</span>
          <h1>{person.data.name}</h1>
          <p class="person-title-line">{person.data.title}</p>
          {person.data.department && <p class="person-dept">{person.data.department}</p>}
          {person.data.researchAreas.length > 0 && (
            <div class="person-areas">
              {person.data.researchAreas.map((area: string) => <span class="tag">{area}</span>)}
            </div>
          )}
          <div class="person-links">
            {person.data.email && (
              <a href={`mailto:${person.data.email}`} class="person-contact-link">
                ✉ {person.data.email}
              </a>
            )}
            {person.data.x && (
              <a href={`https://twitter.com/${person.data.x.replace('@','')}`} target="_blank" rel="noopener" class="person-contact-link">
                𝕏 @{person.data.x.replace('@','')}
              </a>
            )}
            {person.data.linkedin && (
              <a href={person.data.linkedin} target="_blank" rel="noopener" class="person-contact-link">
                LinkedIn ↗
              </a>
            )}
            {person.data.website && (
              <a href={person.data.website} target="_blank" rel="noopener" class="person-contact-link">
                Website ↗
              </a>
            )}
          </div>
        </div>
      </div>

      <div class="person-body prose reveal">
        <Content />
      </div>

      <div class="reveal">
        <LinkedContentList
          label="Selected Publications"
          items={linkedPubs}
          kind="publications"
          emptyCopy="Publications will appear here when linked."
        />
      </div>
      <div class="reveal">
        <LinkedContentList
          label="Talks"
          items={linkedTalks}
          kind="events"
          emptyCopy="Talks will appear here when linked."
        />
      </div>
    </div>
  </article>
</Base>

<style>
.person-detail { padding: 4rem 0 8rem; }
.container { max-width: 800px; margin: 0 auto; padding: 0 1.5rem; }

.breadcrumb { margin-bottom: 2rem; }
.breadcrumb a { font-size: 0.875rem; color: var(--color-muted); text-decoration: none; }
.breadcrumb a:hover { color: var(--color-base); }

.person-header {
  display: flex;
  gap: 2rem;
  margin-bottom: 3rem;
  align-items: flex-start;
}

.person-photo {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: color-mix(in srgb, var(--color-accent) 15%, transparent);
}

.person-photo img { width: 100%; height: 100%; object-fit: cover; }

.person-initials {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 2rem;
  color: var(--color-accent);
  font-weight: 400;
}

.person-role-label {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 0.5rem;
}

.person-intro h1 {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 400;
  line-height: 1.2;
  margin-bottom: 0.4rem;
}

.person-title-line { font-size: 0.95rem; color: var(--color-muted); }
.person-dept { font-size: 0.875rem; color: var(--color-muted); margin-bottom: 0.75rem; }

.person-areas {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
  margin: 0.75rem 0;
}

.person-links { display: flex; flex-direction: column; gap: 0.3rem; margin-top: 0.75rem; }

.person-contact-link {
  font-size: 0.85rem;
  color: var(--color-muted);
  text-decoration: none;
  transition: color 0.2s;
}

.person-contact-link:hover { color: var(--color-accent); }

.person-body { font-size: 1rem; }

@media (max-width: 600px) {
  .person-header { flex-direction: column; }
  .person-photo { width: 90px; height: 90px; }
}
</style>
