---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pubs = await getCollection('publications');
  return pubs.map((pub) => ({ params: { slug: pub.id }, props: pub }));
}

const pub = Astro.props;
const { Content } = await render(pub);

const formattedDate = pub.data.date.toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric'
});
const authors = pub.data.authors;
---

<Base title={`${pub.data.title} — RAISE Publications`} description={pub.data.abstract ?? ''}>
  <article class="pub-detail" data-pagefind-body>
    <div class="container">
      <nav class="breadcrumb">
        <a href="/publications">← Publications</a>
      </nav>

      <div class="pub-topics">
        {pub.data.topics.map((t: string) => <span class="tag">{t}</span>)}
      </div>

      <h1 class="pub-title">{pub.data.title}</h1>

      <div class="pub-meta">
        <span class="pub-venue">{pub.data.venue}</span>
        <span class="pub-sep">·</span>
        <time datetime={pub.data.date.toISOString()}>{formattedDate}</time>
      </div>

      <div class="pub-authors">
        {authors.map((author: string, i: number) => (
          <span class="author">
            {author}{i < authors.length - 1 ? ',' : ''}
          </span>
        ))}
      </div>

      <div class="pub-actions">
        {pub.data.pdf && (
          <a href={pub.data.pdf} target="_blank" rel="noopener" class="action-btn action-btn--primary">
            Download PDF ↗
          </a>
        )}
        {pub.data.doi && (
          <a href={`https://doi.org/${pub.data.doi}`} target="_blank" rel="noopener" class="action-btn">
            View on DOI ↗
          </a>
        )}
      </div>

      {pub.data.abstract && (
        <section class="pub-abstract reveal">
          <h2>Abstract</h2>
          <p>{pub.data.abstract}</p>
        </section>
      )}

      <div class="pub-body prose">
        <Content />
      </div>

      <div class="cite-block reveal">
        <h3>Cite as</h3>
        <code class="cite-text">
          {authors.join(', ')}. ({pub.data.date.getFullYear()}). {pub.data.title}. {pub.data.venue}.
          {pub.data.doi ? ` https://doi.org/${pub.data.doi}` : ''}
        </code>
      </div>
    </div>
  </article>
</Base>

<style>
.pub-detail { padding: 4rem 0 8rem; }
.container { max-width: 800px; margin: 0 auto; padding: 0 1.5rem; }

.breadcrumb { margin-bottom: 2rem; }
.breadcrumb a {
  font-size: 0.875rem;
  color: var(--color-muted);
  text-decoration: none;
  transition: color 0.2s;
}
.breadcrumb a:hover { color: var(--color-base); }

.pub-topics { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1.25rem; }

.pub-title {
  font-size: clamp(1.75rem, 4vw, 2.75rem);
  font-weight: 400;
  line-height: 1.2;
  margin-bottom: 1rem;
}

.pub-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  color: var(--color-muted);
  margin-bottom: 0.5rem;
}

.pub-sep { color: var(--color-border); }

.pub-authors {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
  font-size: 0.875rem;
  color: var(--color-muted);
  margin-bottom: 1.5rem;
}

.author { white-space: nowrap; }

.pub-actions { display: flex; gap: 0.75rem; margin-bottom: 2.5rem; flex-wrap: wrap; }

.action-btn {
  display: inline-flex;
  align-items: center;
  padding: 0.6rem 1.25rem;
  border-radius: var(--radius-btn);
  font-size: 0.875rem;
  font-weight: 500;
  text-decoration: none;
  border: 1px solid var(--color-border);
  color: var(--color-muted);
  transition: all 0.2s;
}

.action-btn:hover {
  border-color: var(--color-base);
  color: var(--color-base);
  text-decoration: none;
}

.action-btn--primary {
  background: var(--color-base);
  color: var(--color-surface);
  border-color: var(--color-base);
}

.action-btn--primary:hover {
  background: var(--color-accent);
  border-color: var(--color-accent);
  color: var(--color-surface);
}

.pub-abstract {
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
  padding: 1.5rem 0;
  margin-bottom: 2rem;
}

.pub-abstract h2 {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: 0.75rem;
}

.pub-abstract p {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--color-base);
  opacity: 0.85;
}

.pub-body { margin-bottom: 3rem; }

.cite-block {
  background: color-mix(in srgb, var(--color-base) 4%, transparent);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 1.25rem 1.5rem;
}

.cite-block h3 {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: 0.5rem;
}

.cite-text {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.8rem;
  line-height: 1.6;
  color: var(--color-muted);
  white-space: pre-wrap;
  word-break: break-all;
}
</style>
