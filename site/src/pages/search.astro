---
import Base from '../layouts/Base.astro';
---

<Base
  title="Search — RAISE"
  description="Search publications, events, articles, and people from RAISE."
>
  <section class="page-hero">
    <div class="container">
      <span class="section-label animate-fade-up">Site Search</span>
      <h1 class="animate-fade-up animate-delay-100">Search</h1>
      <p class="page-desc animate-fade-up animate-delay-200">
        Search across publications, events, articles, and people. Press <kbd>/</kbd> anywhere to focus search.
      </p>
    </div>
  </section>

  <div class="container search-container">
    <div id="search" data-pagefind-ui></div>
  </div>
</Base>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script>
  // Bundled module script. Listens to `astro:page-load` (fires on initial load AND
  // after every view transition), so Pagefind UI re-initializes on every route
  // visit. Guard prevents double-mount when the user returns to /search.
  document.addEventListener('astro:page-load', () => {
    const searchEl = document.querySelector('#search');
    if (!searchEl || searchEl.hasChildNodes()) return;

    new PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      resetStyles: false,
      translations: {
        zero_results:
          'No matches for that search. Try different keywords, or browse Articles, Events, People, or Publications.',
      },
    });

    const searchInput = document.querySelector<HTMLInputElement>('#search input');
    if (searchInput) {
      searchInput.focus();
    }
  });
</script>

<style>
.page-hero { padding: 4rem 0 2rem; border-bottom: 1px solid var(--color-border); }
.page-hero h1 { font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 300; margin: 0.5rem 0 1rem; }
.page-desc { color: var(--color-muted); max-width: 56ch; }

.container { max-width: 800px; margin: 0 auto; padding: 0 1.5rem; }

.search-container { padding: 3rem 1.5rem 6rem; }

.section-label {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-accent);
  display: block;
  margin-bottom: 0.5rem;
}

kbd {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  padding: 0.1rem 0.3rem;
  border: 1px solid var(--color-border);
  border-radius: 3px;
  color: var(--color-muted);
}

/* Override Pagefind default styles to match our design system */
:global(#search .pagefind-ui__search-input) {
  font-family: var(--font-body);
  font-size: 1rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-btn);
  padding: 0.75rem 1rem;
  background: var(--color-surface);
  color: var(--color-base);
  width: 100%;
  outline: none;
  transition: border-color 0.2s;
}

:global(#search .pagefind-ui__search-input:focus) {
  border-color: var(--color-accent);
}

:global(#search .pagefind-ui__result-title) {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: 1.1rem;
  color: var(--color-base);
}

:global(#search .pagefind-ui__result-excerpt) {
  font-size: 0.9rem;
  color: var(--color-muted);
  line-height: 1.6;
}

:global(#search .pagefind-ui__button) {
  background: var(--color-base);
  color: var(--color-surface);
  border: none;
  border-radius: var(--radius-btn);
  font-family: var(--font-body);
  font-size: 0.875rem;
  padding: 0.6rem 1.25rem;
  cursor: pointer;
  transition: background 0.2s;
}

:global(#search .pagefind-ui__button:hover) {
  background: var(--color-accent);
}
</style>
