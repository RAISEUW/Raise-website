---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const latestArticles = allArticles
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const allEvents = await getCollection('events');
const upcomingEvents = allEvents
  .filter((e) => e.data.upcoming)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 2);

const researchPillars = [
  {
    num: '01',
    title: 'Applied AI in Underserved Areas',
    description: 'Deploying responsible AI where it can improve lives most — in healthcare, social services, civic engagement, and beyond.',
  },
  {
    num: '02',
    title: 'Epistemological Foundations',
    description: 'Understanding how AI systems come to "know" things, and what that means for trust, accountability, and truth.',
  },
  {
    num: '03',
    title: 'Open & Specialized Systems',
    description: 'Building AI that is transparent, interpretable, and tailored — not black-box monocultures.',
  },
];

const partners = [
  { name: 'eScience Institute', url: 'https://escience.washington.edu' },
  { name: 'UW Data Lab', url: 'https://datalab.uw.edu' },
  { name: 'Information Matters', url: 'https://informationmatters.org' },
  { name: 'InfoSeeking Lab', url: 'https://infoseeking.org' },
];
---

<Base
  title="RAISE — Responsibility in AI Systems and Experiences"
  description="University of Washington research center advancing AI that serves the public good, builds trust, and supports open innovation."
>
  <!-- ── HERO ─────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-label animate-fade-up">
        <span class="tag">University of Washington</span>
      </div>
      <h1 class="hero-heading animate-fade-up animate-delay-100">
        AI that serves<br />
        <em>the public good.</em>
      </h1>
      <p class="hero-sub animate-fade-up animate-delay-200">
        RAISE is a UW research center advancing responsible, trustworthy,
        and open AI — across disciplines, communities, and institutions.
      </p>
      <div class="hero-actions animate-fade-up animate-delay-300">
        <a href="/research" class="btn btn-primary">Our Research</a>
        <a href="/get-involved" class="btn btn-ghost">Get Involved →</a>
      </div>
    </div>
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-orb hero-orb-1"></div>
      <div class="hero-orb hero-orb-2"></div>
    </div>
  </section>

  <!-- ── PILLARS ──────────────────────────────────────── -->
  <section class="section pillars-section">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Research Focus</span>
        <h2>Three pillars of<br />responsible AI</h2>
      </div>
      <div class="pillars-grid">
        {researchPillars.map((pillar) => (
          <div class="pillar-card reveal">
            <span class="pillar-num">{pillar.num}</span>
            <h3 class="pillar-title">{pillar.title}</h3>
            <p class="pillar-desc">{pillar.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── UPCOMING EVENTS ─────────────────────────────── -->
  {upcomingEvents.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Events</span>
          <h2>Upcoming talks</h2>
          <a href="/events" class="section-more">See all events →</a>
        </div>
        <div class="events-grid">
          {upcomingEvents.map((event) => (
            <div class="reveal">
              <EventCard
                slug={event.id}
                upcoming={event.data.upcoming}
                {...event.data}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── ARTICLES ─────────────────────────────────────── -->
  {latestArticles.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <span class="section-label">From the Center</span>
          <h2>Latest articles</h2>
          <a href="/articles" class="section-more">All articles →</a>
        </div>
        <div class="articles-grid">
          {latestArticles.map((article) => (
            <div class="reveal">
              <ArticleCard
                slug={article.id}
                {...article.data}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── STATS ────────────────────────────────────────── -->
  <section class="section stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat reveal">
          <span class="stat-num">40+</span>
          <span class="stat-label">Publications</span>
        </div>
        <div class="stat reveal">
          <span class="stat-num">50+</span>
          <span class="stat-label">Talks & Events</span>
        </div>
        <div class="stat reveal">
          <span class="stat-num">16</span>
          <span class="stat-label">Researchers</span>
        </div>
        <div class="stat reveal">
          <span class="stat-num">3</span>
          <span class="stat-label">Research Pillars</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── PARTNERS ─────────────────────────────────────── -->
  <section class="section partners-section">
    <div class="container">
      <span class="section-label" style="display:block; margin-bottom:1.5rem;">Partners & Affiliates</span>
      <div class="partners-list">
        {partners.map((p) => (
          <a href={p.url} target="_blank" rel="noopener" class="partner-item">
            {p.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────── -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-box">
        <h2 class="cta-heading">Join the conversation.</h2>
        <p class="cta-sub">
          We're a community of researchers, practitioners, policymakers, and students
          working toward AI that everyone can trust.
        </p>
        <div class="cta-actions">
          <a href="/get-involved" class="btn btn-primary">Get Involved</a>
          <a href="https://join.slack.com/t/responsible-ai/shared_invite/zt-2hf5xdt10-PKz2soi1L2kXVdTZ3md3nQ" target="_blank" rel="noopener" class="btn btn-ghost">
            Join Slack ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
/* ── Hero ─────────────────────────────────────── */
.hero {
  position: relative;
  min-height: 90vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 6rem 1.5rem;
}

.hero-inner {
  position: relative;
  z-index: 2;
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}

.hero-label { margin-bottom: 1.5rem; }

.hero-heading {
  margin-bottom: 1.5rem;
  font-size: clamp(3rem, 8vw, 7rem);
  font-weight: 300;
}

.hero-heading em {
  font-style: italic;
  color: var(--color-accent);
}

.hero-sub {
  font-size: clamp(1rem, 2vw, 1.25rem);
  color: var(--color-muted);
  max-width: 60ch;
  margin: 0 auto 2.5rem;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

/* animated orbs */
.hero-bg { position: absolute; inset: 0; pointer-events: none; }

.hero-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  animation: orbPulse 8s ease-in-out infinite alternate;
}

.hero-orb-1 {
  width: min(600px, 70vw);
  height: min(600px, 70vw);
  background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 18%, transparent), transparent 70%);
  top: -10%;
  right: -10%;
}

.hero-orb-2 {
  width: min(400px, 50vw);
  height: min(400px, 50vw);
  background: radial-gradient(circle, color-mix(in srgb, var(--color-accent-muted) 12%, transparent), transparent 70%);
  bottom: 0;
  left: 5%;
  animation-delay: 4s;
}

@keyframes orbPulse {
  from { transform: scale(0.9) translateY(10px); opacity: 0.6; }
  to   { transform: scale(1.1) translateY(-10px); opacity: 1; }
}

/* ── Shared ───────────────────────────────────── */
.section { padding: 5rem 0; }

.container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.section-header {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 3rem;
}

.section-label {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-accent);
  font-weight: 500;
}

.section-more {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--color-muted);
  text-decoration: none;
  transition: color 0.2s;
  margin-top: 0.25rem;
}

.section-more:hover { color: var(--color-base); text-decoration: none; }

/* ── Buttons ──────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.75rem 1.5rem;
  border-radius: var(--radius-btn);
  font-size: 0.95rem;
  font-weight: 500;
  text-decoration: none;
  transition: all 0.2s var(--ease-out-expo);
  cursor: pointer;
}

.btn-primary {
  background: var(--color-base);
  color: var(--color-surface);
  border: 1px solid var(--color-base);
}

.btn-primary:hover {
  background: var(--color-accent);
  border-color: var(--color-accent);
  text-decoration: none;
  transform: translateY(-1px);
}

.btn-ghost {
  background: transparent;
  color: var(--color-base);
  border: 1px solid var(--color-border);
}

.btn-ghost:hover {
  border-color: var(--color-base);
  text-decoration: none;
  transform: translateY(-1px);
}

/* ── Pillars ──────────────────────────────────── */
.pillars-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.pillar-card {
  padding: 2rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  transition: border-color 0.3s, transform 0.3s var(--ease-out-expo);
}

.pillar-card:hover {
  border-color: var(--color-accent-muted);
  transform: translateY(-4px);
}

.pillar-num {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  color: var(--color-accent);
  margin-bottom: 1rem;
}

.pillar-title {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 400;
  line-height: 1.25;
  margin-bottom: 0.75rem;
}

.pillar-desc {
  font-size: 0.9rem;
  color: var(--color-muted);
  line-height: 1.7;
}

/* ── Events / Articles grids ──────────────────── */
.events-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
  gap: 1.25rem;
}

.articles-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

/* ── Stats ────────────────────────────────────── */
.stats-section {
  background: color-mix(in srgb, var(--color-accent) 4%, var(--color-surface));
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  text-align: center;
}

.stat { padding: 1.5rem 0; }

.stat-num {
  display: block;
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 300;
  color: var(--color-base);
  line-height: 1;
  margin-bottom: 0.4rem;
}

.stat-label {
  display: block;
  font-size: 0.875rem;
  color: var(--color-muted);
  font-weight: 500;
}

/* ── Partners ─────────────────────────────────── */
.partners-list {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.partner-item {
  padding: 0.5rem 1.25rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-pill);
  font-size: 0.875rem;
  color: var(--color-muted);
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s;
}

.partner-item:hover {
  border-color: var(--color-base);
  color: var(--color-base);
  text-decoration: none;
}

/* ── CTA ──────────────────────────────────────── */
.cta-box {
  text-align: center;
  max-width: 600px;
  margin: 0 auto;
  padding: 4rem 2rem;
  border: 1px solid var(--color-border);
  border-radius: calc(var(--radius-card) * 2);
  background: color-mix(in srgb, var(--color-accent) 3%, var(--color-surface));
}

.cta-heading {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 300;
  margin-bottom: 1rem;
}

.cta-sub {
  font-size: 1rem;
  color: var(--color-muted);
  line-height: 1.7;
  margin-bottom: 2rem;
}

.cta-actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

/* ── Scroll reveal ────────────────────────────── */
.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.6s var(--ease-out-expo), transform 0.6s var(--ease-out-expo);
}

.reveal.visible {
  opacity: 1;
  transform: none;
}

/* ── Responsive ───────────────────────────────── */
@media (max-width: 1024px) {
  .pillars-grid { grid-template-columns: 1fr; gap: 1rem; }
  .articles-grid { grid-template-columns: 1fr 1fr; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .hero { min-height: 80vh; }
  .articles-grid { grid-template-columns: 1fr; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .events-grid { grid-template-columns: 1fr; }
}

/* ── Dark mode ────────────────────────────────── */
@media (prefers-color-scheme: dark) {
  .pillar-card { border-color: var(--color-border-dark); }
  .stats-section {
    background: color-mix(in srgb, var(--color-accent) 6%, var(--color-base));
    border-top-color: var(--color-border-dark);
    border-bottom-color: var(--color-border-dark);
  }
  .stat-num { color: var(--color-surface); }
  .partner-item { border-color: var(--color-border-dark); }
  .cta-box {
    border-color: var(--color-border-dark);
    background: color-mix(in srgb, var(--color-accent) 6%, var(--color-base));
  }
  .btn-primary { background: var(--color-surface); color: var(--color-base); border-color: var(--color-surface); }
  .btn-ghost { color: var(--color-surface); border-color: var(--color-border-dark); }
  .btn-ghost:hover { border-color: var(--color-surface); }
}
</style>

