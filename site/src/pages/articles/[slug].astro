---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

function readingTimeMinutes(body: string): number {
  const words = body.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 200));
}

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((a) => ({ params: { slug: a.id }, props: a }));
}

const article = Astro.props;
const { Content } = await render(article);

const formattedDate = article.data.date.toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric'
});

const readingTime = `${readingTimeMinutes(article.body ?? '')} min read`;
---

<Base
  title={`${article.data.title} — RAISE`}
  description={article.data.excerpt ?? article.data.title}
  ogImage={article.data.cover}
>
  <article class="article-detail" data-pagefind-body>
    {article.data.cover && (
      <div class="article-hero-img">
        <img src={article.data.cover} alt="" width="1280" height="640" />
      </div>
    )}
    <div class="container">
      <nav class="breadcrumb">
        <a href="/articles">← Articles</a>
      </nav>

      <div class="article-tags">
        {article.data.tags.map((t: string) => <span class="tag">{t}</span>)}
      </div>

      <h1 class="article-title">{article.data.title}</h1>

      <div class="article-byline">
        <span>{article.data.author}</span>
        <span>·</span>
        <time datetime={article.data.date.toISOString()}>{formattedDate}</time>
        <span>·</span>
        <span>{readingTime}</span>
      </div>

      <div class="article-body prose reveal">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
.article-detail { padding: 3rem 0 8rem; }

.article-hero-img {
  width: 100%;
  max-height: 480px;
  overflow: hidden;
  margin-bottom: 3rem;
}

.article-hero-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.container { max-width: 720px; margin: 0 auto; padding: 0 1.5rem; }

.breadcrumb { margin-bottom: 2rem; }
.breadcrumb a {
  font-size: 0.875rem;
  color: var(--color-muted);
  text-decoration: none;
}
.breadcrumb a:hover { color: var(--color-base); }

.article-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1.25rem; }

.article-title {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 300;
  line-height: 1.15;
  margin-bottom: 1rem;
}

.article-byline {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  color: var(--color-muted);
  font-family: var(--font-mono);
  margin-bottom: 2.5rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--color-border);
}

.article-body { font-size: 1.05rem; }
</style>
