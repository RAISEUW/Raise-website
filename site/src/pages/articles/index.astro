---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const sorted = allArticles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const allTags = [...new Set(sorted.flatMap((a) => a.data.tags))].sort();
---

<Base
  title="Articles — RAISE"
  description="News, research updates, and perspectives from the RAISE center."
>
  <section class="page-hero">
    <div class="container">
      <span class="section-label animate-fade-up">From the Center</span>
      <h1 class="animate-fade-up animate-delay-100">Articles</h1>
      <p class="page-desc animate-fade-up animate-delay-200">
        Research updates, event recaps, perspectives, and announcements from RAISE.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {allTags.length > 0 && (
        <div class="tag-filter" role="group" aria-label="Filter by tag">
          <button class="tag-btn active" data-tag="">All</button>
          {allTags.map((tag) => (
            <button class="tag-btn" data-tag={tag}>{tag}</button>
          ))}
        </div>
      )}

      <div class="articles-grid" id="articles-grid">
        {sorted.map((article) => (
          <div class="article-item reveal" data-tags={article.data.tags.join(',')}>
            <ArticleCard slug={article.id} {...article.data} />
          </div>
        ))}
        {sorted.length === 0 && (
          <p style="color: var(--color-muted); font-style: italic; padding: 2rem 0;">
            Articles coming soon. <a href="/get-involved">Subscribe to the mailing list</a> to be notified.
          </p>
        )}
      </div>
      <p class="empty-note hidden" id="articles-empty">No articles match the selected tag.</p>
    </div>
  </section>
</Base>

<style>
.page-hero { padding: 4rem 0 2rem; border-bottom: 1px solid var(--color-border); }
.page-hero h1 { font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 300; margin: 0.5rem 0 1rem; }
.page-desc { color: var(--color-muted); max-width: 56ch; }

.section { padding: 3rem 0 6rem; }
.container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

.section-label {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-accent);
  display: block;
  margin-bottom: 0.5rem;
}

.tag-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 2.5rem;
}

.tag-btn {
  padding: 0.35rem 0.9rem;
  border-radius: var(--radius-pill);
  border: 1px solid var(--color-border);
  background: none;
  font-size: 0.8rem;
  color: var(--color-muted);
  cursor: pointer;
  transition: all 0.2s;
}

.tag-btn:hover { border-color: var(--color-base); color: var(--color-base); }

.tag-btn.active {
  background: var(--color-base);
  color: var(--color-surface);
  border-color: var(--color-base);
}

.articles-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.empty-note { color: var(--color-muted); font-style: italic; margin-top: 1rem; }
.hidden { display: none; }

@media (max-width: 1024px) { .articles-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) { .articles-grid { grid-template-columns: 1fr; } }

@media (prefers-color-scheme: dark) {
  .page-hero { border-bottom-color: var(--color-border-dark); }
  .tag-btn { border-color: var(--color-border-dark); }
  .tag-btn.active { background: var(--color-surface); color: var(--color-base); border-color: var(--color-surface); }
}
</style>

<script>
  const tagBtns = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
  const items = document.querySelectorAll<HTMLElement>('.article-item');
  const emptyEl = document.getElementById('articles-empty')!;

  tagBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag ?? '';
      tagBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      let visible = 0;
      items.forEach((item) => {
        const match = !tag || item.dataset.tags?.split(',').includes(tag);
        item.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      emptyEl.classList.toggle('hidden', visible > 0);
    });
  });
</script>
