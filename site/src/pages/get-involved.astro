---
import Base from '../layouts/Base.astro';
---

<Base
  title="Get Involved — RAISE"
  description="Join the RAISE community — researchers, practitioners, policymakers, and students working toward responsible AI."
>
  <section class="page-hero">
    <div class="container">
      <span class="section-label animate-fade-up">Community</span>
      <h1 class="animate-fade-up animate-delay-100">Get Involved</h1>
      <p class="page-desc animate-fade-up animate-delay-200">
        Whether you're a researcher, practitioner, policymaker, or student — there's a place for you in RAISE.
      </p>
    </div>
  </section>

  <div class="container">
    <!-- Channels -->
    <section class="gi-section">
      <div class="channels-grid">
        <a href="https://join.slack.com/t/responsible-ai/shared_invite/zt-2hf5xdt10-PKz2soi1L2kXVdTZ3md3nQ"
           target="_blank" rel="noopener"
           class="channel-card">
          <div class="channel-icon">💬</div>
          <h2>Join Slack</h2>
          <p>Real-time community for the Responsible AI group. Discussions, announcements, and informal collaboration.</p>
          <span class="channel-cta">Join the workspace ↗</span>
        </a>

        <a href="https://mailman11.u.washington.edu/mailman/listinfo/raisegroup"
           target="_blank" rel="noopener"
           class="channel-card">
          <div class="channel-icon">📬</div>
          <h2>Mailing List</h2>
          <p>Receive updates on upcoming talks, new publications, events, and research opportunities.</p>
          <span class="channel-cta">Subscribe ↗</span>
        </a>

        <a href="https://aiclinic.uw.edu"
           target="_blank" rel="noopener"
           class="channel-card">
          <div class="channel-icon">🏥</div>
          <h2>AI Clinic</h2>
          <p>Need help deploying responsible AI? The AI Clinic offers consulting for academic labs, nonprofits, and public sector orgs.</p>
          <span class="channel-cta">Visit AI Clinic ↗</span>
        </a>
      </div>
    </section>

    <!-- Contact form -->
    <section class="gi-section reveal">
      <h2 class="gi-heading">Get in Touch</h2>
      <p class="gi-desc">Interested in collaborating, speaking at RAISE, or learning more? Send us a message.</p>

      <form
        class="contact-form"
        name="contact"
        method="POST"
        action="/thanks"
        data-netlify="true"
      >
        <input type="hidden" name="form-name" value="contact" />

        <div class="form-row">
          <div class="form-field">
            <label for="name">Full name <span class="required" aria-hidden="true">*</span></label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="email">Email <span class="required" aria-hidden="true">*</span></label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
        </div>

        <div class="form-field">
          <label for="org">Institution / Organization</label>
          <input type="text" id="org" name="org" autocomplete="organization" />
        </div>

        <div class="form-field">
          <label for="message">Your message <span class="required" aria-hidden="true">*</span></label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="submit-btn">Send message →</button>
      </form>
    </section>
  </div>
</Base>

<style>
.page-hero { padding: 4rem 0 2rem; border-bottom: 1px solid var(--color-border); }
.page-hero h1 { font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 300; margin: 0.5rem 0 1rem; }
.page-desc { color: var(--color-muted); max-width: 56ch; }

.container { max-width: 900px; margin: 0 auto; padding: 0 1.5rem; }

.section-label {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-accent);
  display: block;
  margin-bottom: 0.5rem;
}

.gi-section { padding: 3rem 0; border-bottom: 1px solid var(--color-border); }
.gi-section:last-child { border-bottom: none; padding-bottom: 6rem; }

.gi-heading { font-size: 1.75rem; font-weight: 400; margin-bottom: 0.5rem; }
.gi-desc { color: var(--color-muted); margin-bottom: 2rem; }

.channels-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}

.channel-card {
  display: flex;
  flex-direction: column;
  padding: 1.75rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  text-decoration: none;
  color: inherit;
  transition: border-color 0.2s, transform 0.25s var(--ease-out-expo);
}

.channel-card:hover {
  border-color: var(--color-accent-muted);
  transform: translateY(-3px);
  text-decoration: none;
}

.channel-icon { font-size: 1.75rem; margin-bottom: 0.75rem; }

.channel-card h2 { font-size: 1.15rem; font-weight: 600; margin-bottom: 0.5rem; }

.channel-card p { font-size: 0.9rem; color: var(--color-muted); line-height: 1.6; flex: 1; }

.channel-cta {
  display: block;
  margin-top: 1.25rem;
  font-size: 0.85rem;
  font-weight: 500;
  font-family: var(--font-mono);
  color: var(--color-accent);
}

/* Form */
.contact-form { max-width: 600px; }

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-bottom: 1rem;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-bottom: 1rem;
}

label {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--color-base);
}

.required { color: var(--color-accent); }

input, textarea {
  padding: 0.65rem 0.9rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-btn);
  font-size: 0.95rem;
  font-family: var(--font-body);
  color: var(--color-base);
  background: var(--color-surface);
  transition: border-color 0.2s;
  width: 100%;
}

input:focus, textarea:focus {
  outline: none;
  border-color: var(--color-accent);
}

textarea { resize: vertical; }

.submit-btn {
  padding: 0.75rem 1.75rem;
  background: var(--color-base);
  color: var(--color-surface);
  border: none;
  border-radius: var(--radius-btn);
  font-size: 1rem;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s;
}

.submit-btn:hover {
  background: var(--color-accent);
  transform: translateY(-1px);
}

@media (max-width: 768px) {
  .channels-grid { grid-template-columns: 1fr; }
  .form-row { grid-template-columns: 1fr; }
}

@media (prefers-color-scheme: dark) {
  .page-hero { border-bottom-color: var(--color-border-dark); }
  .gi-section { border-bottom-color: var(--color-border-dark); }
  .channel-card { border-color: var(--color-border-dark); }
  input, textarea { background: color-mix(in srgb, var(--color-surface) 5%, var(--color-base)); border-color: var(--color-border-dark); color: var(--color-surface); }
  input:focus, textarea:focus { border-color: var(--color-accent); }
  label { color: var(--color-surface); }
  .submit-btn { background: var(--color-surface); color: var(--color-base); }
  .submit-btn:hover { background: var(--color-accent); color: var(--color-surface); }
}
</style>
