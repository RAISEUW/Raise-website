---
interface Props {
  title: string;
  authors: string[];
  venue: string;
  date: Date;
  topics: string[];
  pdf?: string;
  doi?: string;
  slug: string;
}

const { title, authors, venue, date, topics, pdf, doi, slug } = Astro.props;
const year = date.getFullYear();
const firstAuthor = authors[0];
const etAl = authors.length > 3;
const displayAuthors = etAl ? [...authors.slice(0, 3)] : authors;
---

<article class="pub-card">
  <div class="pub-topics">
    {topics.map((t) => <span class="tag">{t}</span>)}
  </div>
  <h3 class="pub-title">
    <a href={`/publications/${slug}`}>{title}</a>
  </h3>
  <p class="pub-venue">{venue} · {year}</p>
  <p class="pub-authors">
    {displayAuthors.join(', ')}{etAl ? ' et al.' : ''}
  </p>
  <div class="pub-actions">
    {pdf && <a href={pdf} target="_blank" rel="noopener" class="pub-link">PDF ↗</a>}
    {doi && <a href={`https://doi.org/${doi}`} target="_blank" rel="noopener" class="pub-link">DOI ↗</a>}
    <a href={`/publications/${slug}`} class="pub-link pub-link--more">Details →</a>
  </div>
</article>

<style>
.pub-card {
  padding: 1.5rem 0;
  border-bottom: 1px solid var(--color-border);
}

.pub-topics {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
  margin-bottom: 0.75rem;
}

.pub-title {
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 0.3rem;
}

.pub-title a { text-decoration: none; color: inherit; }
.pub-title a:hover { text-decoration: underline; text-underline-offset: 2px; }

.pub-venue {
  font-size: 0.875rem;
  color: var(--color-muted);
  margin-bottom: 0.25rem;
}

.pub-authors {
  font-size: 0.8rem;
  color: var(--color-muted);
}

.pub-actions {
  display: flex;
  gap: 1rem;
  margin-top: 0.75rem;
}

.pub-link {
  font-size: 0.8rem;
  font-weight: 500;
  font-family: var(--font-mono);
  color: var(--color-accent);
  text-decoration: none;
  transition: opacity 0.2s;
}

.pub-link:hover { opacity: 0.7; }

.pub-link--more { color: var(--color-muted); }
</style>
