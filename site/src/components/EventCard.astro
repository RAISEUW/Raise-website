---
interface Props {
  title: string;
  speaker: string;
  date: Date;
  time?: string;
  location: string;
  abstract?: string;
  recording?: string;
  slides?: string;
  upcoming?: boolean;
  slug: string;
}

const { title, speaker, date, time, location, abstract, recording, slides, upcoming = false, slug } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric'
});
---

<article class:list={['event-card', { 'event-card--upcoming': upcoming }]}>
  {upcoming && <div class="upcoming-badge">Upcoming</div>}
  <div class="event-meta">
    <time datetime={date.toISOString()} class="event-date">{formattedDate}</time>
    {time && <span class="event-time">{time}</span>}
    <span class="event-location">{location}</span>
  </div>
  <h3 class="event-title">
    <a href={`/events/${slug}`}>{title}</a>
  </h3>
  <p class="event-speaker">— {speaker}</p>
  {abstract && <p class="event-abstract">{abstract.slice(0, 180)}{abstract.length > 180 ? '…' : ''}</p>}
  <div class="event-actions">
    {recording && <a href={recording} target="_blank" rel="noopener" class="event-link">Watch ↗</a>}
    {slides && <a href={slides} target="_blank" rel="noopener" class="event-link">Slides ↗</a>}
    <a href={`/events/${slug}`} class="event-link event-link--more">Details →</a>
  </div>
</article>

<style>
.event-card {
  padding: 1.5rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  transition: border-color 0.2s, transform 0.25s var(--ease-out-expo);
}

.event-card:hover {
  border-color: var(--color-accent-muted);
  transform: translateY(-2px);
}

.event-card--upcoming {
  border-color: var(--color-accent);
  background: color-mix(in srgb, var(--color-accent) 4%, transparent);
}

.upcoming-badge {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-accent);
  border: 1px solid var(--color-accent);
  padding: 0.15rem 0.5rem;
  border-radius: var(--radius-pill);
  margin-bottom: 0.75rem;
}

.event-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.5rem;
}

.event-date {
  font-size: 0.8rem;
  font-family: var(--font-mono);
  color: var(--color-muted);
  font-weight: 500;
}

.event-time, .event-location {
  font-size: 0.8rem;
  color: var(--color-muted);
}

.event-time::before, .event-location::before { content: '·'; margin-right: 0.5rem; }

.event-title {
  font-family: var(--font-body);
  font-size: 1.05rem;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 0.25rem;
}

.event-title a { text-decoration: none; color: inherit; }
.event-title a:hover { text-decoration: underline; text-underline-offset: 2px; }

.event-speaker {
  font-size: 0.875rem;
  color: var(--color-muted);
  margin-bottom: 0.5rem;
}

.event-abstract {
  font-size: 0.875rem;
  color: var(--color-muted);
  line-height: 1.6;
  margin-bottom: 0.75rem;
}

.event-actions {
  display: flex;
  gap: 1rem;
  margin-top: 0.75rem;
}

.event-link {
  font-size: 0.8rem;
  font-weight: 500;
  font-family: var(--font-mono);
  color: var(--color-accent);
  text-decoration: none;
  transition: opacity 0.2s;
}

.event-link:hover { opacity: 0.7; }
.event-link--more { color: var(--color-muted); }
</style>
