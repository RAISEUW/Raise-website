---
interface Props {
  title: string;
  date: Date;
  author: string;
  tags: string[];
  excerpt?: string;
  cover?: string;
  slug: string;
}

const { title, date, author, tags, excerpt, cover, slug } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric'
});
---

<article class="article-card">
  {cover && (
    <a href={`/articles/${slug}`} class="article-cover-link" tabindex="-1">
      <div class="article-cover">
        <img src={cover} alt="" loading="lazy" width="800" height="420" />
      </div>
    </a>
  )}
  <div class="article-body">
    <div class="article-meta">
      <time datetime={date.toISOString()}>{formattedDate}</time>
      <span>·</span>
      <span>{author}</span>
    </div>
    <h3 class="article-title">
      <a href={`/articles/${slug}`}>{title}</a>
    </h3>
    {excerpt && <p class="article-excerpt">{excerpt}</p>}
    {tags.length > 0 && (
      <div class="article-tags">
        {tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    )}
  </div>
</article>

<style>
.article-card {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  overflow: hidden;
  transition: border-color 0.2s, transform 0.25s var(--ease-out-expo);
}

.article-card:hover {
  border-color: var(--color-accent-muted);
  transform: translateY(-3px);
}

.article-cover { aspect-ratio: 16/9; overflow: hidden; }
.article-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s var(--ease-out-expo);
}

.article-card:hover .article-cover img { transform: scale(1.04); }

.article-body { padding: 1.25rem 1.5rem 1.5rem; }

.article-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.8rem;
  font-family: var(--font-mono);
  color: var(--color-muted);
  margin-bottom: 0.6rem;
}

.article-title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 400;
  line-height: 1.3;
  margin-bottom: 0.5rem;
}

.article-title a { text-decoration: none; color: inherit; }
.article-title a:hover { text-decoration: underline; text-underline-offset: 2px; }

.article-excerpt {
  font-size: 0.9rem;
  color: var(--color-muted);
  line-height: 1.6;
  margin-bottom: 0.75rem;
}

.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
}
</style>
